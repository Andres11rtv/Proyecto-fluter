import '../widgets/movimiento_portada.dart';
import '../widgets/vidrio_portada.dart';
import 'historial_general_screen.dart';
import '../widgets/sobre_portada.dart';
import '../widgets/galeria_portada.dart';
import '../services/obra_service_impl.dart';
import '../widgets/portada_coleccion.dart';
import 'coleccion_screen.dart';
import '../widgets/franja_cultural.dart';
import 'dart:ui';
import 'package:flutter/material.dart';
import '../theme/app_theme.dart';
import 'artistas_screen.dart';
import 'categorias_screen.dart';
import 'museos_screen.dart';
import 'obras_screen.dart';
import 'recorridos_screen.dart';
import 'salas_screen.dart';

class InicioScreen extends StatefulWidget {
  const InicioScreen({super.key});

  @override
  State<InicioScreen> createState() => _InicioScreenState();
}

class _InicioScreenState extends State<InicioScreen> {
  final TextEditingController _searchCtrl = TextEditingController();
  final servicio = ObraServiceImpl();
  late var obras = servicio.obtenerObras();
  int version = 0;
  final desplazamiento = ScrollController();
  final secciones = {for (final id in ['inicio', 'sobre', 'coleccion']) id: GlobalKey()};
  final activa = ValueNotifier<String>('inicio');
  int viaje = 0;
  bool navegando = false;

  @override
  void initState() {
    super.initState();
    desplazamiento.addListener(actualizarSeccion);
  }

  void actualizarSeccion() {
    if (navegando || !desplazamiento.hasClients) return;
    String visible = 'inicio';
    for (final entrada in secciones.entries) {
      final caja = entrada.value.currentContext?.findRenderObject();
      if (caja is RenderBox && caja.hasSize && caja.localToGlobal(Offset.zero).dy <= 126) {
        visible = entrada.key;
      }
    }
    if (desplazamiento.position.extentAfter <= 1 && desplazamiento.offset > 0) {
      visible = 'coleccion';
    }
    activa.value = visible;
  }

  Future<void> irASeccion(String id) async {
    final caja = secciones[id]?.currentContext?.findRenderObject();
    if (caja is! RenderBox || !desplazamiento.hasClients) return;
    final numero = ++viaje;
    navegando = true;
    activa.value = id;
    final destino = id == 'inicio' ? 0.0 : (desplazamiento.offset +
        caja.localToGlobal(Offset.zero).dy - 118)
        .clamp(0.0, desplazamiento.position.maxScrollExtent).toDouble();
    final distancia = (desplazamiento.offset - destino).abs();
    try {
      if (distancia < 1 || MediaQuery.disableAnimationsOf(context)) {
        desplazamiento.jumpTo(destino);
      } else {
        final tiempo = (340 + distancia * 0.24).clamp(360, 820).round();
        await desplazamiento.animateTo(destino, duration: Duration(milliseconds: tiempo),
          curve: Curves.easeInOutCubic);
      }
    } finally {
      if (mounted && viaje == numero) {
        navegando = false;
        actualizarSeccion();
      }
    }
  }

  Future<void> _irA(Widget pantalla) async {
    await Navigator.push(context, MaterialPageRoute(builder: (_) => pantalla));
    if (mounted) setState(() { version++; obras = servicio.obtenerObras(); });
  }

  @override
  void dispose() {
    desplazamiento.dispose();
    activa.dispose();
    _searchCtrl.dispose();
    super.dispose();
  }

  bool get _esContraste => AppTheme.modo == 'contrast';

  Color _vidrio([double alphaClaro = 0.74]) {
    if (_esContraste) return AppTheme.surface;
    return AppTheme.surface.withValues(alpha: alphaClaro);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: MuseoBackdrop(
        child: SafeArea(
          child: Stack(
            children: [
              Positioned.fill(
                child: Scrollbar(
                  controller: desplazamiento,
                  thumbVisibility: true,
                  interactive: true,
                  thickness: 10,
                  radius: const Radius.circular(6),
                  scrollbarOrientation: ScrollbarOrientation.right,
                  child: ScrollConfiguration(
                    behavior: ScrollConfiguration.of(context).copyWith(scrollbars: false),
                    child: SingleChildScrollView(
                      controller: desplazamiento,
                      padding: const EdgeInsets.fromLTRB(20, 119, 20, 24),
                      child: Center(
                        child: ConstrainedBox(
                          constraints: const BoxConstraints(maxWidth: 1140),
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.stretch,
                            children: [
                              KeyedSubtree(key: secciones['inicio'], child: _buildHero()),
                              const SizedBox(height: 20),
                              _buildTicker(),
                              const SizedBox(height: 42),
                              KeyedSubtree(key: secciones['sobre'], child: const SobrePortada()),
                              const SizedBox(height: 42),
                              KeyedSubtree(key: secciones['coleccion'], child: GaleriaPortada(key: ValueKey(version), obras: obras, abrir: _irA)),
                              const SizedBox(height: 78),
                              _buildFooter(),
                            ],
                          ),
                        ),
                      ),
                    ),
                  ),
                ),
              ),
              Positioned(
                top: 21,
                left: 20,
                right: 20,
                child: Center(
                  child: ConstrainedBox(
                    constraints: const BoxConstraints(maxWidth: 1140),
                    child: _buildTopNavbar(),
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildTopNavbar() {
    if (MediaQuery.sizeOf(context).width < 760) {
      return ClipRRect(
        borderRadius: BorderRadius.circular(999),
        child: BackdropFilter(
          filter: ImageFilter.blur(
            sigmaX: _esContraste ? 0 : 24,
            sigmaY: _esContraste ? 0 : 24,
          ),
          child: Container(
            padding: const EdgeInsets.fromLTRB(18, 8, 10, 8),
            decoration: BoxDecoration(
              color: _vidrio(0.78),
              border: Border.all(
                color: _esContraste
                    ? AppTheme.line
                    : AppTheme.surface.withValues(alpha: 0.8),
              ),
              borderRadius: BorderRadius.circular(999),
            ),
            child: Row(
              children: [
                InkWell(
                  borderRadius: BorderRadius.circular(8),
                  onTap: () => irASeccion('inicio'),
                  child: Text(
                    'MUSEO',
                    style: AppTheme.serif(
                      size: 19,
                      weight: FontWeight.w700,
                      letterSpacing: 3,
                    ),
                  ),
                ),
                const Spacer(),
                PopupMenuButton<String>(
                  tooltip: 'Secciones de inicio',
                  icon: Icon(Icons.menu_rounded, color: AppTheme.ink),
                  onSelected: (id) {
                    switch (id) {
                      case 'inicio':
                        irASeccion('inicio');
                      case 'sobre':
                        irASeccion('sobre');
                      case 'coleccion':
                        irASeccion('coleccion');
                    }
                  },
                  itemBuilder: (_) => const [
                    PopupMenuItem(value: 'inicio', child: Text('Inicio')),
                    PopupMenuItem(value: 'sobre', child: Text('El Museo')),
                    PopupMenuItem(value: 'coleccion', child: Text('Colección')),
                  ],
                ),
                _buildAdminMenuButton(),
              ],
            ),
          ),
        ),
      );
    }

    return VidrioPortada(
      radio: 999,
      child: Padding(
          padding: const EdgeInsets.fromLTRB(24, 8, 12, 8),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              MouseRegion(
                cursor: SystemMouseCursors.click,
                child: GestureDetector(
                  onTap: () => irASeccion('inicio'),
                  child: Text(
                    'MUSEO',
                    style: AppTheme.serif(
                      size: 20,
                      weight: FontWeight.w700,
                      letterSpacing: 5.5,
                    ),
                  ),
                ),
              ),
              Container(
                padding: const EdgeInsets.all(4),
                decoration: BoxDecoration(
                  color: AppTheme.head.withValues(alpha: 0.75),
                  borderRadius: BorderRadius.circular(999),
                  border: Border.all(color: AppTheme.line),
                ),
                child: ValueListenableBuilder<String>(
                  valueListenable: activa,
                  builder: (_, actual, _) => _NavegacionPortada(actual: actual, alElegir: irASeccion),
                ),
              ),
              _buildAdminMenuButton(),
            ],
          ),
      ),
    );
  }

  // La selección y el indicador se dibujan en _NavegacionPortada.

  Widget _buildAdminMenuButton() {
    return MenuAnchor(
      alignmentOffset: const Offset(0, 8),
      style: const MenuStyle(
        alignment: AlignmentDirectional.bottomEnd,
        backgroundColor: WidgetStatePropertyAll(Colors.transparent),
        surfaceTintColor: WidgetStatePropertyAll(Colors.transparent),
        elevation: WidgetStatePropertyAll(0),
        padding: WidgetStatePropertyAll(EdgeInsets.zero),
      ),
      builder: (context, controller, child) {
        final abierto = controller.isOpen;
        return VidrioPortada(
          radio: 24,
          child: IconButton(
            tooltip: abierto ? 'Cerrar menú' : 'Abrir administración',
            onPressed: () {
              if (abierto) {
                controller.close();
              } else {
                controller.open();
              }
            },
            style: IconButton.styleFrom(
              fixedSize: const Size(44, 44),
              foregroundColor: AppTheme.bronze,
              hoverColor: AppTheme.bronze.withValues(alpha: 0.10),
            ),
            icon: AnimatedSwitcher(
              duration: const Duration(milliseconds: 160),
              child: Icon(
                abierto ? Icons.close_rounded : Icons.menu_rounded,
                key: ValueKey(abierto),
                size: 22,
              ),
            ),
          ),
        );
      },
      menuChildren: [
        VidrioPortada(
          radio: 20,
          child: SizedBox(
            width: 244,
            child: Padding(
              padding: const EdgeInsets.all(8),
              child: Column(
                mainAxisSize: MainAxisSize.min,
                crossAxisAlignment: CrossAxisAlignment.stretch,
                children: [
        _menuItem(
          const MuseosScreen(),
          Icons.account_balance_outlined,
          'Museos',
          'Sedes y ubicaciones',
        ),
        _menuItem(
          const SalasScreen(),
          Icons.meeting_room_outlined,
          'Salas',
          'Espacios de exposición',
        ),
        _menuItem(
          const ArtistasScreen(),
          Icons.person_outline,
          'Artistas',
          'Autores y biografías',
        ),
        _menuItem(
          const CategoriasScreen(),
          Icons.category_outlined,
          'Categorías',
          'Clasificación de piezas',
        ),
        _menuItem(
          const ObrasScreen(),
          Icons.photo_library_outlined,
          'Obras',
          'Inventario y estado',
        ),
        _menuItem(const HistorialGeneralScreen(), Icons.history, 'Historial', 'Exposiciones de obras'),
        _menuItem(
          const RecorridosScreen(),
          Icons.route_outlined,
          'Recorridos',
          'Visitas guiadas',
        ),
                ],
              ),
            ),
          ),
        ),
      ],
    );
  }

  Widget _menuItem(Widget screen, IconData icon, String title, String subtitle) {
    return MenuItemButton(
      onPressed: () => _irA(screen),
      style: ButtonStyle(
        alignment: Alignment.centerLeft,
        padding: const WidgetStatePropertyAll(
          EdgeInsets.symmetric(horizontal: 10, vertical: 8),
        ),
        shape: WidgetStatePropertyAll(
          RoundedRectangleBorder(borderRadius: BorderRadius.circular(13)),
        ),
        overlayColor: WidgetStatePropertyAll(
          AppTheme.bronze.withValues(alpha: 0.12),
        ),
      ),
      leadingIcon: Container(
        width: 34,
        height: 34,
        alignment: Alignment.center,
        decoration: BoxDecoration(
          color: AppTheme.bronze.withValues(alpha: 0.10),
          borderRadius: BorderRadius.circular(11),
        ),
        child: Icon(icon, size: 18, color: AppTheme.bronze),
      ),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(title, style: AppTheme.sans(size: 14, weight: FontWeight.w600)),
          Text(subtitle, style: AppTheme.sans(size: 12, color: AppTheme.muted)),
        ],
      ),
    );
  }

  List<Color> _heroGradientColors() {
    if (AppTheme.modo == 'dark') {
      const base = Color(0xFF0B0E14);
      return [
        base.withValues(alpha: 0.96),
        base.withValues(alpha: 0.86),
        base.withValues(alpha: 0.38),
        base.withValues(alpha: 0.12),
      ];
    }
    if (_esContraste) {
      return [
        Colors.black.withValues(alpha: 0.99),
        Colors.black.withValues(alpha: 0.96),
        Colors.black.withValues(alpha: 0.85),
        Colors.black.withValues(alpha: 0.72),
      ];
    }
    const base = Color(0xFFFCF9F4);
    return [
      base.withValues(alpha: 0.96),
      base.withValues(alpha: 0.85),
      base.withValues(alpha: 0.28),
      base.withValues(alpha: 0.04),
    ];
  }

  Widget _buildHero() {
    final compacto = MediaQuery.sizeOf(context).width < 700;
    return ClipRRect(
      borderRadius: BorderRadius.circular(32),
      child: Container(
        decoration: BoxDecoration(
          color: AppTheme.surface,
          border: Border.all(color: AppTheme.line, width: 1.5),
          boxShadow: _esContraste
              ? null
              : [
                  BoxShadow(
                    color: AppTheme.ink.withValues(alpha: 0.08),
                    blurRadius: 34,
                    offset: const Offset(0, 14),
                  ),
                ],
        ),
        child: Stack(
          children: [
            if (!_esContraste)
              Positioned.fill(child: Image.network(
                'https://images.unsplash.com/photo-1518998053901-5348d3961a04?auto=format&fit=crop&w=1200&q=80', fit: BoxFit.cover, alignment: Alignment.centerRight,
                webHtmlElementStrategy: WebHtmlElementStrategy.fallback,
                excludeFromSemantics: true,
                errorBuilder: (_, _, _) => ColoredBox(color: AppTheme.head),
              )),
            Positioned.fill(
              child: DecoratedBox(
                decoration: BoxDecoration(
                  gradient: LinearGradient(
                    begin: Alignment.centerLeft,
                    end: Alignment.centerRight,
                    stops: const [0.0, 0.44, 0.76, 1.0],
                    colors: compacto ? [for (final color in _heroGradientColors()) color.withValues(alpha: 0.92)] : _heroGradientColors(),
                  ),
                ),
              ),
            ),
            Padding(
              padding: EdgeInsets.fromLTRB(
                compacto ? 18 : 45,
                compacto ? 26 : 44,
                compacto ? 18 : 45,
                compacto ? 22 : 44,
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Container(
                    padding: const EdgeInsets.symmetric(
                      horizontal: 13,
                      vertical: 8,
                    ),
                    decoration: BoxDecoration(
                      color: _vidrio(0.84),
                      border: Border.all(color: AppTheme.bronze, width: 1.3),
                      borderRadius: BorderRadius.circular(999),
                    ),
                    child: Row(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        CircleAvatar(
                          radius: 3,
                          backgroundColor: AppTheme.bronze,
                        ),
                        const SizedBox(width: 8),
                        Text(
                          'TEMPORADA CULTURAL ${DateTime.now().year}',
                          style: AppTheme.sans(
                            size: compacto ? 9 : 10.5,
                            weight: FontWeight.w700,
                            letterSpacing: compacto ? 1.1 : 2,
                            color: AppTheme.bronze,
                          ),
                        ),
                      ],
                    ),
                  ),
                  const SizedBox(height: 18),
                  ConstrainedBox(
                    constraints: const BoxConstraints(maxWidth: 520),
                    child: EntradaTexto(child: RichText(
                      text: TextSpan(
                        style: AppTheme.serif(
                          size: compacto ? 39 : 58,
                          height: 1.03,
                          weight: FontWeight.w600,
                          letterSpacing: -0.6,
                        ),
                        children: [
                          const TextSpan(text: 'Espacios que\n'),
                          TextSpan(
                            text: 'inspiran ',
                            style: AppTheme.serif(
                              size: compacto ? 39 : 58,
                              height: 1.03,
                              weight: FontWeight.w600,
                              style: FontStyle.italic,
                              color: AppTheme.bronze,
                            ),
                          ),
                          const TextSpan(text: 'historia'),
                        ],
                      ),
                    )),
                  ),
                  const SizedBox(height: 16),
                  ConstrainedBox(
                    constraints: const BoxConstraints(maxWidth: 540),
                    child: Text(
                      'Un viaje arquitectónico y curatorial por nuestras colecciones, salas de exhibición y patrimonio histórico en un solo lugar.',
                      style: AppTheme.sans(
                        size: 16,
                        height: 1.6,
                        color: AppTheme.inkSecondary,
                      ),
                    ),
                  ),
                  const SizedBox(height: 30),
                  ConstrainedBox(
                    constraints: const BoxConstraints(maxWidth: 470),
                    child: Container(
                      padding: const EdgeInsets.fromLTRB(18, 4, 6, 4),
                      decoration: BoxDecoration(
                        color: _vidrio(0.82),
                        borderRadius: BorderRadius.circular(999),
                        border: Border.all(color: AppTheme.line, width: 1.5),
                        boxShadow: _esContraste
                            ? null
                            : [
                                BoxShadow(
                                  color: AppTheme.ink.withValues(alpha: 0.05),
                                  blurRadius: 18,
                                  offset: const Offset(0, 4),
                                ),
                              ],
                      ),
                      child: Row(
                        children: [
                          Icon(Icons.search, color: AppTheme.bronze, size: 19),
                          const SizedBox(width: 10),
                          Expanded(
                            child: TextField(
                              controller: _searchCtrl,
                              style: AppTheme.sans(size: 14),
                              decoration: const InputDecoration(
                                hintText: 'Buscar obra, artista o época…',
                                border: InputBorder.none,
                                enabledBorder: InputBorder.none,
                                focusedBorder: InputBorder.none,
                                filled: false,
                                contentPadding: EdgeInsets.zero,
                              ),
                              onSubmitted: (texto) =>
                                  _irA(ColeccionScreen(busquedaInicial: texto)),
                            ),
                          ),
                          AlPasar(child: FilledButton(
                            onPressed: () => _irA(
                              ColeccionScreen(busquedaInicial: _searchCtrl.text),
                            ),
                            style: FilledButton.styleFrom(
                              padding: const EdgeInsets.symmetric(
                                horizontal: 20,
                                vertical: 10,
                              ),
                            ),
                            child: const Text('Buscar'),
                          )),
                        ],
                      ),
                    ),
                  ),
                  SizedBox(height: compacto ? 26 : 44),
                  PortadaColeccion(key: ValueKey(version), obras: obras),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildTicker() => const FranjaCultural();

  Widget _buildFooter() {
    return Container(
      padding: const EdgeInsets.only(top: 24),
      decoration: BoxDecoration(
        border: Border(top: BorderSide(color: AppTheme.line)),
      ),
      child: Wrap(
        alignment: WrapAlignment.spaceBetween,
        spacing: 20,
        runSpacing: 8,
        children: [
          Text(
            'MUSEO',
            style: AppTheme.serif(
              size: 16,
              weight: FontWeight.w700,
              letterSpacing: 4.5,
            ),
          ),
          Wrap(children: [
          TextButton(onPressed: () => irASeccion('inicio'), child: const Text('Inicio')),
          TextButton(onPressed: () => irASeccion('sobre'), child: const Text('El Museo')),
          TextButton(onPressed: () => irASeccion('coleccion'), child: const Text('Colección')),
          ]),
          Text(
            'Proyecto universitario',
            style: AppTheme.sans(size: 12.5, color: AppTheme.muted),
          ),
        ],
      ),
    );
  }
}

class _NavegacionPortada extends StatefulWidget {
  final String actual;
  final ValueChanged<String> alElegir;
  const _NavegacionPortada({required this.actual, required this.alElegir});
  @override
  State<_NavegacionPortada> createState() => _NavegacionPortadaState();
}

class _NavegacionPortadaState extends State<_NavegacionPortada> with SingleTickerProviderStateMixin {
  static const ids = ['inicio', 'sobre', 'coleccion'];
  late final control = TabController(length: ids.length, vsync: this,
    initialIndex: ids.indexOf(widget.actual), animationDuration: const Duration(milliseconds: 320));

  @override
  void didUpdateWidget(covariant _NavegacionPortada anterior) {
    super.didUpdateWidget(anterior);
    final indice = ids.indexOf(widget.actual);
    if (control.index != indice) {
      control.animateTo(indice, duration: MediaQuery.disableAnimationsOf(context)
          ? Duration.zero : const Duration(milliseconds: 320), curve: Curves.easeInOutCubic);
    }
  }

  @override
  void dispose() {
    control.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) => TabBar(
    controller: control, isScrollable: true, tabAlignment: TabAlignment.start,
    indicatorSize: TabBarIndicatorSize.tab, dividerHeight: 0,
    indicator: BoxDecoration(color: AppTheme.btn, borderRadius: BorderRadius.circular(24)),
    labelColor: AppTheme.btnTexto, unselectedLabelColor: AppTheme.ink,
    labelStyle: AppTheme.sans(size: 13.5, weight: FontWeight.w600),
    labelPadding: const EdgeInsets.symmetric(horizontal: 16),
    splashBorderRadius: BorderRadius.circular(24),
    onTap: (i) => widget.alElegir(ids[i]),
    tabs: const [Tab(height: 38, text: 'Inicio'), Tab(height: 38, text: 'El Museo'),
      Tab(height: 38, text: 'Colección')],
  );
}
